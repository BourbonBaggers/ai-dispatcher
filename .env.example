# ai-dispatcher — example environment file.
# Copy to `.env` and fill in real values. NEVER commit a real .env.
# Every value here is a NAME + DESCRIPTION only; no secrets are checked in.
#
# Authentication is owned by the CLIs themselves (gh, codex, claude) on the host
# where this service runs. This service never stores a GitHub, OpenAI, or Anthropic
# token. The variables below configure behaviour, paths, and notifications — not auth.

# ── Target repository ────────────────────────────────────────────────────────
# Optional default for the required --repo argument (canonical owner/repository).
# The CLI flag always wins; if neither is set the service refuses to start.
# There is intentionally NO hard-coded fallback repository.
DISPATCHER_REPO=

# ── Local checkouts on the host that runs agents ─────────────────────────────
# A pristine mirror clone of the target repo, kept on origin/main. The service
# runs its git operations and clones per-run checkouts from here.
DISPATCHER_REPO_DIR=

# Parent directory for per-run agent checkouts (one clone per issue branch).
DISPATCHER_WORKTREE_DIR=

# Optional: a checkout whose .env is copied into each run checkout so the agent
# can run the target repo's tests/migrations. Leave empty to skip seeding.
DISPATCHER_ENV_SOURCE_DIR=

# ── Runtime behaviour ────────────────────────────────────────────────────────
# How often (seconds) the poll loop scans for eligible issues. Default 900 (15m).
DISPATCHER_POLL_INTERVAL_SECONDS=900

# Wall-clock budget per agent run, in minutes. Default 90.
DISPATCHER_MAX_RUNTIME_MINUTES=90

# Directory for durable dispatcher state (runs, cooldowns, failures, lock).
# Default: ./state relative to the working directory.
DISPATCHER_STATE_DIR=

# Log level: debug | info | warn | error. Default info.
DISPATCHER_LOG_LEVEL=info

# Original issue author authorization. Default author-allowlist; that mode fails closed
# unless at least one trusted GitHub login is configured.
DISPATCHER_ISSUE_AUTHOR_AUTH_MODE=author-allowlist
DISPATCHER_TRUSTED_ISSUE_AUTHORS=

# ── Autoship hook (opt-in) ───────────────────────────────────────────────────
# Optional repo-specific merge/deploy/health/rollback command. The dispatcher gates CI,
# then runs it from AUTOSHIP_DEPLOYMENT_CHECKOUT with exact SHA context. There is no
# data-loss, destructive-change, draft, or human-review gate; backup + rollback are the
# safety net and failures enter automated recovery.
DISPATCHER_AUTOSHIP_CMD=
# Dedicated deployment checkout. Defaults to:
#   <DISPATCHER_STATE_DIR>/autoship-deployments/<owner>-<repo>
DISPATCHER_AUTOSHIP_DEPLOYMENT_DIR=
# Complete merge/deploy/verify/rollback ceiling. Default 120 minutes. Timeout kills the
# entire process tree and enters deploy recovery; output size never aborts the command.
DISPATCHER_AUTOSHIP_TIMEOUT_MINUTES=120

# Exact generated paths eligible for deterministic conflict repair.
DISPATCHER_GENERATED_CONFLICT_ALLOWLIST=docs/memory.md,docs/researcher.md
# Optional target-repository command that regenerates those paths after repair.
DISPATCHER_GENERATED_CONFLICT_REGEN_CMD=
DISPATCHER_GENERATED_CONFLICT_MAX_ATTEMPTS=1
DISPATCHER_GENERATED_CONFLICT_CI_WAIT_SECONDS=900

# Independent repair budget for each owned phase: agent, CI, merge, and deploy. After
# this many assigned-model attempts, the escalation model runs once automatically. Only
# failure after that final attempt creates autoship-held and pages the operator.
DISPATCHER_CI_SELF_HEAL_MAX_ATTEMPTS=2
DISPATCHER_CI_ESCALATION_MODEL=claude-opus-4-8

# Idle-only stale blocked-queue recovery. The audit uses a non-frontier model and low
# effort, checks dependency issue states, and removes at most one `blocked` label per
# scan after normal eligible work is drained.
DISPATCHER_BLOCKED_QUEUE_AUDIT_MODEL=claude-sonnet-5
DISPATCHER_BLOCKED_QUEUE_AUDIT_EFFORT=effort:low
DISPATCHER_BLOCKED_QUEUE_AUDIT_MAX_CANDIDATES=3
#
# Self-shipping (the dispatcher shipping ITSELF to BourbonBaggers/ai-dispatcher):
#   - DISPATCHER_AUTOSHIP_CMD must point at THIS repo's purpose-built self-ship script,
#     e.g. DISPATCHER_AUTOSHIP_CMD=/home/<user>/ai-dispatcher/scripts/self-ship.sh
#     (NOT internal-tools/scripts/dispatcher-ship.sh — that ships a different service).
#   - DISPATCHER_AUTOSHIP_DEPLOYMENT_DIR must be the checkout the systemd unit runs FROM,
#     e.g. DISPATCHER_AUTOSHIP_DEPLOYMENT_DIR=~/ai-dispatcher, so a restart actually
#     serves the merged code. self-ship.sh restarts DISPATCHER_SELFSHIP_UNIT
#     (default ai-dispatcher.service) via a detached unit and rolls back on an unhealthy
#     start. A HELD self-modification means assigned-model repairs and the automatic
#     frontier attempt both failed and durable exhaustion proof exists. Removing its
#     `autoship-held` label resumes the existing PR; it does NOT re-run from scratch.

# ── Notifications (ntfy) ─────────────────────────────────────────────────────
# Base URL and topic for ntfy push notifications. Leave empty to disable pushes.
NTFY_URL=
NTFY_TOPIC=
