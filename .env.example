# ai-dispatcher — example environment file.
# Copy to `.env` and fill in real values. NEVER commit a real .env.
# Every value here is a NAME + DESCRIPTION only; no secrets are checked in.
#
# Authentication is owned by the CLIs themselves (gh, codex, claude) on the host
# where this service runs. This service never stores a GitHub, OpenAI, or Anthropic
# token. The variables below configure behaviour, paths, and notifications — not auth.

# ── Target repository ────────────────────────────────────────────────────────
# Optional default for the required --repo argument (canonical owner/repository).
# The CLI flag always wins; if neither is set the service refuses to start.
# There is intentionally NO hard-coded fallback repository.
DISPATCHER_REPO=

# ── Local checkouts on the host that runs agents ─────────────────────────────
# A pristine mirror clone of the target repo, kept on origin/main. The service
# runs its git operations and clones per-run checkouts from here.
DISPATCHER_REPO_DIR=

# Parent directory for per-run agent checkouts (one clone per issue branch).
DISPATCHER_WORKTREE_DIR=

# Optional: a checkout whose .env is copied into each run checkout so the agent
# can run the target repo's tests/migrations. Leave empty to skip seeding.
DISPATCHER_ENV_SOURCE_DIR=

# ── Runtime behaviour ────────────────────────────────────────────────────────
# How often (seconds) the poll loop scans for eligible issues. Default 900 (15m).
DISPATCHER_POLL_INTERVAL_SECONDS=900

# Wall-clock budget per agent run, in minutes. Default 90.
DISPATCHER_MAX_RUNTIME_MINUTES=90

# Directory for durable dispatcher state (runs, cooldowns, failures, lock).
# Default: ./state relative to the working directory.
DISPATCHER_STATE_DIR=

# Log level: debug | info | warn | error. Default info.
DISPATCHER_LOG_LEVEL=info

# ── Optional autoship hook ───────────────────────────────────────────────────
# Command run (with $ISSUE and $PR in the environment) when a run succeeds with a
# green PR. Repo-specific and OFF by default — the standalone service opens a draft
# PR and stops unless you opt in. Leave empty to disable autoship entirely.
DISPATCHER_AUTOSHIP_CMD=

# ── Notifications (ntfy) ─────────────────────────────────────────────────────
# Base URL and topic for ntfy push notifications. Leave empty to disable pushes.
NTFY_URL=
NTFY_TOPIC=
